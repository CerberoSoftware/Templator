Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Block dotfiles
RewriteRule (^|/)\. - [F]

# Block direct access to server-side directories
RewriteRule ^(app|migrations|scripts|tests|node_modules|src|public)(/|$) - [F]

# Block root-level source/config files
RewriteRule ^([^/]+\.(sql|sh|ts|tsx|json|ya?ml|lock|md|html))$ - [F]

# Block direct PHP access except index.php
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule \.php$ - [F]

# Route /static/* and /uploads/* through index.php (PHP streams the file, bypassing nginx DT block)
RewriteRule ^(static|uploads)/(.*)$ index.php [QSA,L]

# Serve existing files/dirs directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else to index.php
RewriteRule ^ index.php [QSA,L]
